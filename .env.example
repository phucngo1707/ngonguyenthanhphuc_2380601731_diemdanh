# Database Configuration (MySQL 8)
# Tên database: DB_[HoTenKhongDau]_[MSSV]_PrimeAttendance
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=prime_user
DB_PASSWORD=prime_secure_password_2026
