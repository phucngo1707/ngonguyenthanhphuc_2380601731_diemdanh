// ==============================================================================
// PRIME Student Attendance Database Schema
// Database: DB_NgoNguyenThanhPhuc_2380601731_DiemDanh (MySQL 8)
// Sinh viên: Ngo Nguyen Thanh Phuc - MSSV: 2380601731
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  TEACHER
  STUDENT
}

enum SessionStatus {
  SCHEDULED
  OPEN
  PENDING
  ACTIVE
  CLOSED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  EXCUSED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum OtpType {
  REGISTER
  LOGIN
  FORGOT_PASSWORD
}

// 1. Users (Tài khoản, email, mật khẩu hash, role và trạng thái xác minh email)
model User {
  id              String    @id @default(uuid())
  username        String    @unique @db.VarChar(50)
  email           String    @unique @db.VarChar(120)
  passwordHash    String    @map("password_hash") @db.VarChar(255)
  fullName        String    @map("full_name") @db.VarChar(100)
  role            UserRole  @default(STUDENT)
  phoneNumber     String?   @map("phone_number") @db.VarChar(20)
  studentCode     String?   @unique @map("student_code") @db.VarChar(30)
  teacherCode     String?   @unique @map("teacher_code") @db.VarChar(30)
  isEmailVerified Boolean   @default(true) @map("is_email_verified")
  isFaceEnrolled  Boolean   @default(false) @map("is_face_enrolled")
  faceEnrolledAt  DateTime? @map("face_enrolled_at")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relationships
  taughtClasses          Class[]               @relation("TeacherClasses")
  enrollments            Enrollment[]
  attendanceRecords      AttendanceRecord[]    @relation("StudentRecords")
  modifiedRecords        AttendanceRecord[]    @relation("TeacherModifiedRecords")
  attendanceSessions     AttendanceSession[]   @relation("TeacherSessions")
  leaveRequests          LeaveRequest[]        @relation("StudentLeaves")
  reviewedLeaves         LeaveRequest[]        @relation("TeacherReviewedLeaves")
  passwordResetTokens    PasswordResetToken[]

  @@map("users")
}

// 2. Email OTPs (Mã xác minh email và OTP đăng nhập, quên mật khẩu)
model EmailOtp {
  id        String   @id @default(uuid())
  email     String   @db.VarChar(120)
  otp       String   @db.VarChar(10)
  type      OtpType  @default(REGISTER)
  expiresAt DateTime @map("expires_at")
  attempts  Int      @default(0)
  isUsed    Boolean  @default(false) @map("is_used")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email, type])
  @@map("email_otps")
}

// 3. Password Reset Tokens (Dữ liệu phục vụ đặt lại mật khẩu)
model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique @db.VarChar(100)
  expiresAt DateTime @map("expires_at")
  isUsed    Boolean  @default(false) @map("is_used")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("password_reset_tokens")
}

// 4. Classes (Lớp học phần, môn học, giảng viên phụ trách và lưu trữ)
model Class {
  id          String   @id @default(uuid())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(150)
  subjectName String   @map("subject_name") @db.VarChar(150)
  teacherId   String   @map("teacher_id")
  room        String?  @db.VarChar(50)
  schedule    String?  @db.VarChar(100)
  semester    String   @default("HK1-2025-2026") @db.VarChar(50)
  isArchived  Boolean  @default(false) @map("is_archived")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  teacher     User     @relation("TeacherClasses", fields: [teacherId], references: [id], onDelete: Restrict)
  enrollments Enrollment[]
  sessions    AttendanceSession[]
  leaveRequests LeaveRequest[]

  @@map("classes")
}

// 5. Enrollments (Sinh viên thuộc lớp nào)
model Enrollment {
  id        String   @id @default(uuid())
  studentId String   @map("student_id")
  classId   String   @map("class_id")
  enrolledAt DateTime @default(now()) @map("enrolled_at")

  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([studentId, classId], name: "unique_student_class")
  @@map("enrollments")
}

// 6. Attendance Sessions (Các phiên điểm danh)
model AttendanceSession {
  id              String        @id @default(uuid())
  classId         String        @map("class_id")
  teacherId       String        @map("teacher_id")
  sessionCode     String        @unique @map("session_code") @db.VarChar(50)
  title           String        @db.VarChar(150)
  startTime       DateTime      @map("start_time")
  endTime         DateTime      @map("end_time")
  status          SessionStatus @default(OPEN)
  durationMinutes Int           @default(15) @map("duration_minutes")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  class           Class         @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher         User          @relation("TeacherSessions", fields: [teacherId], references: [id], onDelete: Restrict)
  records         AttendanceRecord[]

  @@map("attendance_sessions")
}

// 7. Attendance Records (Trạng thái điểm danh từng sinh viên)
model AttendanceRecord {
  id                  String           @id @default(uuid())
  sessionId           String           @map("session_id")
  studentId           String           @map("student_id")
  checkInTime         DateTime         @default(now()) @map("check_in_time")
  status              AttendanceStatus @default(PRESENT)
  method              String           @default("DYNAMIC_QR") @db.VarChar(20)
  deviceInfo          String?          @map("device_info") @db.VarChar(255)
  verifiedBiometric   Boolean          @default(false) @map("verified_biometric")
  modifiedByTeacherId String?          @map("modified_by_teacher_id")
  modifiedReason      String?          @map("modified_reason") @db.VarChar(255)
  modifiedAt          DateTime?        @map("modified_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  session             AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student             User              @relation("StudentRecords", fields: [studentId], references: [id], onDelete: Cascade)
  modifiedBy          User?             @relation("TeacherModifiedRecords", fields: [modifiedByTeacherId], references: [id], onDelete: SetNull)

  @@unique([sessionId, studentId], name: "unique_session_student")
  @@map("attendance_records")
}

// 8. Leave Requests (Đơn xin nghỉ phép và trạng thái duyệt)
model LeaveRequest {
  id            String      @id @default(uuid())
  studentId     String      @map("student_id")
  classId       String      @map("class_id")
  reason        String      @db.Text
  attachmentUrl String?     @map("attachment_url") @db.VarChar(500)
  ocrText       String?     @map("ocr_text") @db.Text
  startDate     DateTime    @map("start_date")
  endDate       DateTime    @map("end_date")
  status        LeaveStatus @default(PENDING)
  reviewedById  String?     @map("reviewed_by_id")
  reviewNotes   String?     @map("review_notes") @db.Text
  reviewedAt    DateTime?   @map("reviewed_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  student       User        @relation("StudentLeaves", fields: [studentId], references: [id], onDelete: Cascade)
  class         Class       @relation(fields: [classId], references: [id], onDelete: Cascade)
  reviewedBy    User?       @relation("TeacherReviewedLeaves", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@map("leave_requests")
}
