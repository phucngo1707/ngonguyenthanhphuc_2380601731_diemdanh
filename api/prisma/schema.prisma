// ==============================================================================
// PRIME Attendance - Prisma Database Schema
// Database Name: DB_NgoNguyenThanhPhuc_2380601731_PrimeAttendance
// Student: Ngo Nguyen Thanh Phuc - Student ID: 2380601731
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// 1. User & Authentication
// -----------------------------------------------------------------------------
enum UserRole {
  ADMIN
  TEACHER
  STUDENT
}

model User {
  id           String    @id @default(uuid())
  username     String    @unique @db.VarChar(50)
  email        String    @unique @db.VarChar(120)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  fullName     String    @map("full_name") @db.VarChar(100)
  avatarUrl    String?   @map("avatar_url") @db.VarChar(255)
  role         UserRole  @default(STUDENT)
  phoneNumber  String?   @map("phone_number") @db.VarChar(20)
  studentCode  String?   @unique @map("student_code") @db.VarChar(30)
  teacherCode  String?   @unique @map("teacher_code") @db.VarChar(30)
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Relationships
  taughtSections         ClassSection[]      @relation("TeacherSections")
  enrollments            Enrollment[]
  attendanceRecords      AttendanceRecord[]  @relation("StudentRecords")
  modifiedRecords        AttendanceRecord[]  @relation("TeacherModifiedRecords")
  attendanceSessions     AttendanceSession[] @relation("TeacherSessions")
  leaveRequests          LeaveRequest[]      @relation("StudentLeaves")
  reviewedLeaves         LeaveRequest[]      @relation("TeacherReviewedLeaves")
  registeredNfcTags      RegisteredNfcTag[]
  refreshTokens          RefreshToken[]
  emailOtps              EmailOtp[]
  auditLogs              AuditLog[]

  @@map("users")
}

// -----------------------------------------------------------------------------
// 2. Faculties (Khoa)
// -----------------------------------------------------------------------------
model Faculty {
  id          String    @id @default(uuid())
  code        String    @unique @db.VarChar(30)
  name        String    @db.VarChar(150)
  description String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  subjects    Subject[]

  @@map("faculties")
}

// -----------------------------------------------------------------------------
// 3. Subjects (Môn học)
// -----------------------------------------------------------------------------
model Subject {
  id          String         @id @default(uuid())
  code        String         @unique @db.VarChar(30)
  name        String         @db.VarChar(150)
  credits     Int            @default(3)
  facultyId   String         @map("faculty_id")
  description String?        @db.Text
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  faculty     Faculty        @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  sections    ClassSection[]

  @@map("subjects")
}

// -----------------------------------------------------------------------------
// 4. Classrooms (Phòng học)
// -----------------------------------------------------------------------------
model Classroom {
  id           String          @id @default(uuid())
  roomCode     String          @unique @map("room_code") @db.VarChar(50)
  building     String          @db.VarChar(50)
  floor        Int             @default(1)
  capacity     Int             @default(50)
  latitude     Decimal?        @db.Decimal(10, 8)
  longitude    Decimal?        @db.Decimal(11, 8)
  radiusMeters Int             @default(50) @map("radius_meters")
  createdAt    DateTime        @default(now()) @map("created_at")

  sections     ClassSection[]
  schedules    ClassSchedule[]

  @@map("classrooms")
}

// -----------------------------------------------------------------------------
// 5. Class Sections (Lớp học phần)
// -----------------------------------------------------------------------------
enum ClassSectionStatus {
  PLANNING
  ACTIVE
  COMPLETED
  CANCELLED
}

model ClassSection {
  id           String              @id @default(uuid())
  code         String              @unique @db.VarChar(50)
  name         String              @db.VarChar(150)
  subjectId    String              @map("subject_id")
  teacherId    String              @map("teacher_id")
  classroomId  String?             @map("classroom_id")
  semester     String              @db.VarChar(20)
  academicYear String              @map("academic_year") @db.VarChar(20)
  maxStudents  Int                 @default(60) @map("max_students")
  status       ClassSectionStatus  @default(ACTIVE)
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  subject      Subject             @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  teacher      User                @relation("TeacherSections", fields: [teacherId], references: [id], onDelete: Restrict)
  classroom    Classroom?          @relation(fields: [classroomId], references: [id], onDelete: SetNull)

  enrollments  Enrollment[]
  schedules    ClassSchedule[]
  sessions     AttendanceSession[]
  leaveRequests LeaveRequest[]

  @@map("class_sections")
}

// -----------------------------------------------------------------------------
// 6. Enrollments (Danh sách sinh viên trong lớp học phần)
// -----------------------------------------------------------------------------
enum EnrollmentStatus {
  ENROLLED
  DROPPED
  COMPLETED
}

model Enrollment {
  id             String           @id @default(uuid())
  studentId      String           @map("student_id")
  classSectionId String           @map("class_section_id")
  enrolledAt     DateTime         @default(now()) @map("enrolled_at")
  status         EnrollmentStatus @default(ENROLLED)

  student        User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classSection   ClassSection     @relation(fields: [classSectionId], references: [id], onDelete: Cascade)

  @@unique([studentId, classSectionId], name: "unique_student_section")
  @@map("enrollments")
}

// -----------------------------------------------------------------------------
// 7. Class Schedules (Lịch học)
// -----------------------------------------------------------------------------
model ClassSchedule {
  id             String       @id @default(uuid())
  classSectionId String       @map("class_section_id")
  classroomId    String?      @map("classroom_id")
  dayOfWeek      Int          @map("day_of_week") // 2 = Mon, ..., 8 = Sun
  startPeriod    Int          @map("start_period")
  endPeriod      Int          @map("end_period")
  startTime      String       @map("start_time") @db.VarChar(10) // "07:30"
  endTime        String       @map("end_time") @db.VarChar(10)   // "11:00"

  classSection   ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  classroom      Classroom?   @relation(fields: [classroomId], references: [id], onDelete: SetNull)

  @@map("class_schedules")
}

// -----------------------------------------------------------------------------
// 8. Attendance Sessions (Phiên điểm danh)
// -----------------------------------------------------------------------------
enum SessionStatus {
  PENDING
  ACTIVE
  CLOSED
  CANCELLED
}

model AttendanceSession {
  id              String         @id @default(uuid())
  classSectionId  String         @map("class_section_id")
  teacherId       String         @map("teacher_id")
  sessionCode     String         @unique @map("session_code") @db.VarChar(50)
  title           String         @db.VarChar(150)
  startTime       DateTime       @map("start_time")
  endTime         DateTime       @map("end_time")
  status          SessionStatus  @default(PENDING)
  durationMinutes Int            @default(15) @map("duration_minutes")
  allowNfc        Boolean        @default(true) @map("allow_nfc")
  allowBiometric  Boolean        @default(false) @map("allow_biometric")
  allowGps        Boolean        @default(false) @map("allow_gps")
  soundLevelAvgDb Float?         @map("sound_level_avg_db")
  soundPeakDb     Float?         @map("sound_peak_db")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  classSection    ClassSection   @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  teacher         User           @relation("TeacherSessions", fields: [teacherId], references: [id], onDelete: Restrict)

  records         AttendanceRecord[]
  leaveRequests   LeaveRequest[]

  @@map("attendance_sessions")
}

// -----------------------------------------------------------------------------
// 9. Attendance Records (Bản ghi điểm danh)
// -----------------------------------------------------------------------------
enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  EXCUSED
}

enum CheckInMethod {
  DYNAMIC_QR
  NFC
  MANUAL
  BIOMETRIC
}

model AttendanceRecord {
  id                  String           @id @default(uuid())
  sessionId           String           @map("session_id")
  studentId           String           @map("student_id")
  checkInTime         DateTime         @default(now()) @map("check_in_time")
  status              AttendanceStatus @default(PRESENT)
  method              CheckInMethod    @default(DYNAMIC_QR)
  deviceInfo          String?          @map("device_info") @db.VarChar(255)
  ipAddress           String?          @map("ip_address") @db.VarChar(50)
  latitude            Decimal?         @db.Decimal(10, 8)
  longitude           Decimal?         @db.Decimal(11, 8)
  verifiedBiometric   Boolean          @default(false) @map("verified_biometric")
  modifiedByTeacherId String?          @map("modified_by_teacher_id")
  modifiedReason      String?          @map("modified_reason") @db.VarChar(255)
  updatedAt           DateTime         @updatedAt @map("updated_at")

  session             AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student             User              @relation("StudentRecords", fields: [studentId], references: [id], onDelete: Cascade)
  modifiedBy          User?             @relation("TeacherModifiedRecords", fields: [modifiedByTeacherId], references: [id], onDelete: SetNull)

  @@unique([sessionId, studentId], name: "unique_session_student")
  @@map("attendance_records")
}

// -----------------------------------------------------------------------------
// 10. Leave Requests (Đơn xin nghỉ phép)
// -----------------------------------------------------------------------------
enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveRequest {
  id             String           @id @default(uuid())
  studentId      String           @map("student_id")
  classSectionId String           @map("class_section_id")
  sessionId      String?          @map("session_id")
  reason         String           @db.Text
  startDate      DateTime         @map("start_date")
  endDate        DateTime         @map("end_date")
  status         LeaveStatus      @default(PENDING)
  reviewedById   String?          @map("reviewed_by_id")
  reviewNotes    String?          @map("review_notes") @db.Text
  reviewedAt     DateTime?        @map("reviewed_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  student        User             @relation("StudentLeaves", fields: [studentId], references: [id], onDelete: Cascade)
  classSection   ClassSection     @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  session        AttendanceSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  reviewedBy     User?            @relation("TeacherReviewedLeaves", fields: [reviewedById], references: [id], onDelete: SetNull)

  attachments    LeaveAttachment[]

  @@map("leave_requests")
}

// -----------------------------------------------------------------------------
// 11. Leave Attachments (Tệp minh chứng)
// -----------------------------------------------------------------------------
model LeaveAttachment {
  id             String       @id @default(uuid())
  leaveRequestId String       @map("leave_request_id")
  fileName       String       @map("file_name") @db.VarChar(255)
  filePath       String       @map("file_path") @db.VarChar(500)
  fileSize       Int          @map("file_size")
  mimeType       String       @map("mime_type") @db.VarChar(100)
  ocrText        String?      @map("ocr_text") @db.Text
  createdAt      DateTime     @default(now()) @map("created_at")

  leaveRequest   LeaveRequest @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)

  @@map("leave_attachments")
}

// -----------------------------------------------------------------------------
// 12. Registered NFC Tags (Thẻ NFC)
// -----------------------------------------------------------------------------
model RegisteredNfcTag {
  id           String    @id @default(uuid())
  studentId    String    @map("student_id")
  tagUid       String    @unique @map("tag_uid") @db.VarChar(100)
  tagLabel     String?   @map("tag_label") @db.VarChar(100)
  isActive     Boolean   @default(true) @map("is_active")
  registeredAt DateTime  @default(now()) @map("registered_at")

  student      User      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("registered_nfc_tags")
}

// -----------------------------------------------------------------------------
// 13. Email OTPs (Mã xác thực 6 số)
// -----------------------------------------------------------------------------
enum OtpPurpose {
  LOGIN
  RESET_PASSWORD
}

model EmailOtp {
  id          String     @id @default(uuid())
  email       String     @db.VarChar(120)
  userId      String?    @map("user_id")
  otpHash     String     @map("otp_hash") @db.VarChar(255)
  purpose     OtpPurpose @default(LOGIN)
  expiresAt   DateTime   @map("expires_at")
  attempts    Int        @default(0)
  maxAttempts Int        @default(3) @map("max_attempts")
  isUsed      Boolean    @default(false) @map("is_used")
  createdAt   DateTime   @default(now()) @map("created_at")

  user        User?      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, isUsed, expiresAt])
  @@map("email_otps")
}

// -----------------------------------------------------------------------------
// 14. Refresh Tokens
// -----------------------------------------------------------------------------
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  isRevoked Boolean   @default(false) @map("is_revoked")
  createdAt DateTime  @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// -----------------------------------------------------------------------------
// 15. Audit Logs (Nhật ký kiểm toán)
// -----------------------------------------------------------------------------
model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(100)
  entityId   String?  @map("entity_id") @db.VarChar(100)
  oldValues  String?  @map("old_values") @db.Text
  newValues  String?  @map("new_values") @db.Text
  ipAddress  String?  @map("ip_address") @db.VarChar(50)
  userAgent  String?  @map("user_agent") @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at")

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([action, entityType])
  @@map("audit_logs")
}
